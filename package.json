{
  "name": "seoul-pocket",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "An offline-first, iPhone-first Seoul travel companion. No runtime dependencies.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs public",
    "preview": "node scripts/serve.mjs dist",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm test && npm run build && npm run check:privacy",
    "check:audio": "node scripts/check-audio.mjs",
    "prepare:stay": "node scripts/prepare-stay.mjs",
    "check:privacy": "node scripts/check-privacy.mjs"
  }
}
